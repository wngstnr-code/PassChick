PORT=8000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_service_role_key

# Celo network
# Mainnet: 42220 / https://forno.celo.org
# Sepolia testnet: 11142220 / https://forno.celo-sepolia.celo-testnet.org
NETWORK_NAME=celo-sepolia
CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
CELO_CHAIN_ID=11142220
NATIVE_TOKEN_SYMBOL=CELO
MIN_RECOMMENDED_NATIVE_BALANCE=0.05

# Celo contracts
USDC_ADDRESS=
GAME_VAULT_ADDRESS=
GAME_SETTLEMENT_ADDRESS=
TRUST_PASSPORT_ADDRESS=
FAUCET_CONTRACT_ADDRESS=
# TicketVault (V2 daily claim / ticket ledger). Feature is disabled (503) when empty.
# Celo Mainnet: 0x8a1bd73DDFb4E06779D9c578a6447aE9B48199D5
# Celo Sepolia (dev): 0x1490e6B836f552e8504fE6404C30953B15F899c8
TICKET_VAULT_ADDRESS=
TOKEN_DECIMALS=6
ADMIN_ADDRESS=
BACKEND_SIGNER_ADDRESS=

FAUCET_MODE=claim
FAUCET_AMOUNT_UNITS=100000000
FAUCET_COOLDOWN_SECONDS=300

# REQUIRED. EVM backend signer private key, hex with or without 0x. Do not commit real keys.
# Backend fails fast (process.exit) at startup if this is empty.
BACKEND_PRIVATE_KEY=

SETTLEMENT_SIGNATURE_TTL_SECONDS=86400
PASSPORT_SIGNATURE_TTL_SECONDS=900
PASSPORT_VALIDITY_SECONDS=2592000
# TTL (seconds) for signed daily-claim EIP-712 signatures. Must match TicketVault's
# on-chain `claimSignatureTtl` (600s on both Mainnet and Sepolia as of 2026-07-22).
DAILY_CLAIM_SIGNATURE_TTL_SECONDS=600

# Operator key for TicketVault.creditBatch/spendBatch (onlyOperator; distinct
# from BACKEND_PRIVATE_KEY). MUST be a different keypair from BACKEND_PRIVATE_KEY -
# do not reuse the signer that produces EIP-712 claim signatures. Its address must
# be registered on-chain via `setOperator(address, true)` by the SC team (onlyOwner)
# before creditBatch/spendBatch will succeed (otherwise reverts UnauthorizedOperator).
# It also needs its own CELO balance to pay gas - fund it separately from treasury.
# Optional: when empty, the reward-batch worker degrades gracefully (skips ticking,
# rest of the backend runs unaffected).
OPERATOR_PRIVATE_KEY=
# Reward-batch worker tick interval in ms (default 5 minutes).
REWARD_BATCH_TICK_MS=300000

SOCIAL_AUTH_ENABLED=true

# Reject MiniPay auth requests whose User-Agent does not contain "MiniPay".
MINIPAY_UA_CHECK_ENABLED=true
# When true, /auth/social rejects wallet providers not recognized as social/embedded.
AUTH_STRICT_PROVIDERS=false
# Season progression tick interval in ms (used by other v2 modules).
SEASON_TICK_MS=60000
