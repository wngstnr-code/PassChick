#
# Celo Mainnet
#
CELO_RPC_URL=https://forno.celo.org
PRIVATE_KEY=0xyour_private_key
CELOSCAN_API_KEY=your_celoscan_api_key
USDC_ADDRESS=0xcebA9300f2b948710d2653dD7B07f33A8B32118C

# Optional overrides for a fresh deployment
INITIAL_OWNER=0xyour_owner_address
BACKEND_SIGNER=0xyour_backend_signer_address
SESSION_EXPIRY_DELAY=86400

# Current Celo Mainnet deployment addresses
GAME_VAULT_ADDRESS=
GAME_SETTLEMENT_ADDRESS=
TRUST_PASSPORT_ADDRESS=

# For signer rotation script
NEW_BACKEND_SIGNER=0xyour_new_backend_signer_address

#
# V2: TicketVault deployment (DeployV2Contracts.s.sol)
#
# Receives every ticket purchase. TicketVault forwards funds here directly and
# never custodies them, so this address only ever RECEIVES - it never signs and
# never needs a CELO balance. Keep its private key OFF this machine.
# Must differ from the owner address: if the owner key leaks, revenue already
# collected here stays out of reach.
TICKET_TREASURY=0xyour_treasury_address
DAILY_CLAIM_SIGNATURE_TTL=600

# Stablecoins whitelisted for ticket top-up.
#
# WARNING: the deploy script whitelists every token address it finds here. To
# deploy with the shop CLOSED (see update_v2.md 14 Fase 1b), override all three
# to empty on the command line - a plain `source .env` will open the shop:
#   USDC_ADDRESS= USDT_ADDRESS= CUSD_ADDRESS= forge script ... --sig "run()"
# Verify before broadcasting: the dry-run JSON must contain exactly 2 CREATE
# transactions and zero setToken calls.
USDT_ADDRESS=0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e
CUSD_ADDRESS=0x765DE816845861e75A25fCA122bb6898B8B1282a

# Live Celo Mainnet V2 deployment (shop still CLOSED - setToken never called)
TICKET_VAULT_ADDRESS=0x8a1bd73DDFb4E06779D9c578a6447aE9B48199D5
TICKET_TREASURY_ADDRESS=0xEf29d941Be65495631f908EC3211625555D374b9

# Celo Sepolia V2 deployment (shop OPEN, use this for development)
# TICKET_VAULT_ADDRESS=0x1490e6B836f552e8504fE6404C30953B15F899c8

#
# Celo Sepolia demo / testnet
#
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
USDC_FAUCET_CLAIM_AMOUNT=100000000

# Current Celo Sepolia deployment addresses
GAME_VAULT_ADDRESS=0x4Bf6D3C0dBbC14eF0C7f2a4daeD7D97418Fc5aDf
GAME_SETTLEMENT_ADDRESS=0x1eC57C9D24C4bf326d6efF4a1F16B45968e384e4
TRUST_PASSPORT_ADDRESS=0xF8Bc8B497Cbb7D08a14Ba2107F2C521c78B0eC38
